# Copie este archivo como .env y complete valores. No use estos marcadores en producción.

ENVIRONMENT=development
DEBUG=false
APP_VERSION=1.0.0

# Genere con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIE_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_48_CARACTERES
# Genere con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CAMBIE_ESTA_CLAVE_FERNET

DB_HOST=localhost
DB_PORT=5432
DB_NAME=27auditoria
DB_USER=postgres
DB_PASSWORD=CAMBIE_ESTA_CONTRASENA
# Opcional: URL completa; si se define, prevalece sobre DB_*.
# DATABASE_URL_OVERRIDE=postgresql+psycopg://usuario:clave@db:5432/27auditoria

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Solo si el backend está detrás de un proxy de confianza (Nginx, Traefik).
TRUSTED_PROXY_IPS=127.0.0.1,::1

# n8n (perfil automation de Docker Compose)
# Genere con: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=CAMBIE_ESTA_CLAVE_DE_N8N
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# En producción, habilite solo las redes internas que correspondan.
AUDIT_ALLOW_PRIVATE_TARGETS=false
AUDIT_ALLOWED_CIDRS=
SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=20
AUDIT_MAX_CONCURRENT_RUNS=2

# El conector simulado SOLO se usa en pruebas. Nunca en producción.
ENABLE_SIMULATED_CONNECTOR=false

AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

ARTIFACT_STORAGE_DIR=generated
REPORTS_MAX_PERIOD_DAYS=366
MAX_PAGE_SIZE=200
